<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Minutes</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- minutes://meeting/<id>?t=<seconds>: the links in saved chats. Opening one only shows the meeting there. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.rosslopez.minutes.meeting-link</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>minutes</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Minutes records the audio your Mac plays during a meeting, so it can transcribe what other people say. It stays on this Mac.</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Ross Lopez. Licensed under the GNU GPL, version 3 or later.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Plain http to a model server on this Mac or the user's network: IP addresses, .local names and
		     names without a dot. Minutes itself refuses http to servers outside the network. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Minutes connects to model servers you add on your network, such as LM Studio on another Mac, to write summaries.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Minutes records your microphone during a meeting, so it can transcribe what you say. It stays on this Mac.</string>
	<!-- Sparkle: the update feed, attached to the latest GitHub release. Checking fetches only this file. -->
	<key>SUFeedURL</key>
	<string>https://github.com/RossLopez/minutes/releases/latest/download/appcast.xml</string>
	<!-- From Config/Release.xcconfig. Empty in Debug builds and forks, which then don't check for updates. -->
	<key>SUPublicEDKey</key>
	<string>$(SPARKLE_PUBLIC_KEY)</string>
	<!-- Never send Sparkle's anonymous system profile. -->
	<key>SUEnableSystemProfiling</key>
	<false/>
	<!-- Not sandboxed, so Sparkle installs without its XPC services. -->
	<key>SUEnableInstallerLauncherService</key>
	<false/>
	<key>SUEnableDownloaderService</key>
	<false/>
</dict>
</plist>
