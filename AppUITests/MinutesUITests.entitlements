<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The test runner only, never the app: EndpointFlowUITests serves a stand-in model server on
	     127.0.0.1, and the runner's sandbox refuses to listen without this. -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
